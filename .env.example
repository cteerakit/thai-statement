# Required for NextAuth (generate: openssl rand -base64 32)
AUTH_SECRET=

# Optional: Google OAuth for sign-in / history
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: restrict sign-in to one email domain (e.g. yourcompany.com)
# ALLOWED_EMAIL_DOMAIN=

# Optional: trust X-Forwarded-For / X-Real-IP for rate limiting (local reverse proxy)
# TRUST_PROXY_HEADERS=1

# Optional: PostgreSQL for conversion history + auth adapter
DATABASE_URL=postgresql://user:password@localhost:5432/statement_converter
